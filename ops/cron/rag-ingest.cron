# /etc/cron.d/rag-ingest — worker do eixo de estudos (share -> RAG do OWUI).
#
# Instalado por: sudo install -m 644 ops/cron/rag-ingest.cron /etc/cron.d/rag-ingest
# Runner: ops/bin/rag_ingest.sh (instalado em /usr/local/bin/rag-ingest).
#
# A cada 15 min: você copia o PDF no Explorer e ele aparece no chat em <= 15 min,
# sem tocar em nada. O worker ainda espera 30 s de estabilidade antes de ler o
# arquivo (cópia grande não é lida pela metade).
#
# Roda como usuario: é o dono do share (~/documents) e do estado (~/rag-state).
# Como root, _relatorio/ e _rejeitados/ nasceriam com dono root dentro do share
# e o usuário não conseguiria mexer. O wrapper também toma flock, então um lote
# grande (16 PDFs = 9m45s) nunca é atropelado pela execução seguinte.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/home/usuario

*/15 * * * * usuario /usr/local/bin/rag-ingest
