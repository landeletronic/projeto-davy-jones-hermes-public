# =============================================================================
# .env.example — modelo das variáveis do lab (copie para .env e preencha)
#
#   copy .env.example .env      (PowerShell)
#
# O .env real NUNCA é versionado (.gitignore). Sem ele o compose não sobe:
# API_SERVER_KEY é obrigatório e falha com mensagem clara.
# =============================================================================
COMPOSE_FILE=docker-compose.yml

# Chave da API do gateway Hermes (porta 8642). Gere uma nova com:
#   openssl rand -hex 32
# Precisa ser a MESMA nos dois lados: compose (env) e conexão do OWUI.
API_SERVER_KEY=<gere com: openssl rand -hex 32>

# Senha do admin do Grafana. Só tem efeito no PRIMEIRO boot do volume
# (depois disso: grafana cli admin reset-admin-password + restart).
GRAFANA_ADMIN_PASSWORD=<defina uma senha forte>

# Dashboard do Hermes Agent (http://<host>:9119) — login do formulário.
# O compose lê estas três: sem elas o compose recusa subir (mensagem clara).
# Trocar qualquer uma exige: docker compose up -d hermes-dashboard
#   (o sync-to-host.ps1 copia o .env, mas NÃO aplica o compose)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=<gere com: openssl rand -hex 32>
# Chave que assina o cookie de sessão: trocá-la derruba TODAS as sessões abertas.
# É ela que impede que um cookie antigo continue valendo depois de trocar a senha.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=<gere com: openssl rand -hex 32>
